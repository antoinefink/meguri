# Local copy of the real Anki collection (personal data, never commit)
/local-data/

# Machine-local VM, tools and credentials; never publish this directory
/.local/

# Reference checkouts (separate git repos; Anki is AGPL and never part of Meguri)
/refs/

# tools/mg job results and reports
/build/

# Local overrides of the sync server's test users (docker/syncserver.env.example)
/docker/syncserver.env

# Rust build output (host builds; Docker builds use a named volume)
/core/target/
/server/target/

# cargo-fuzz's default output directories (tools/mg core-fuzz keeps corpora on
# tmpfs and findings under build/)
/core/fuzz/target/
/core/fuzz/corpus/
/core/fuzz/artifacts/
/core/fuzz/coverage/

# XCFramework and generated UniFFI Swift bindings (rebuilt from core/)
/app/Packages/MeguriCore/Binaries/
/app/Packages/MeguriCore/Sources/MeguriCoreBindings/

# SwiftPM build output of the local packages
/app/Packages/*/.build/
/app/Packages/*/.swiftpm/

# Xcode
DerivedData/
xcuserdata/

# Python virtual environments (macOS-native oracle lane)
.venv*

# Per-worktree Claude Code settings (tools/mg worktree new renders the
# implementer deny profile here)
.claude/settings.local.json

# Python bytecode (the similarity scanner)
__pycache__/
