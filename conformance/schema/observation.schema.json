{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meguri.local/conformance/schema/observation.schema.json",
  "$comment": "SPDX-License-Identifier: MPL-2.0. Semantics: specs/conformance/observations.md, and specs/conformance/sync-ops.md for the outputs of sync and converge.",
  "title": "Observations of one scenario run",
  "description": "One output per scenario step, in step order (O1). Draft kinds accept any value until their area defines it.",
  "type": "object",
  "required": ["steps"],
  "additionalProperties": false,
  "properties": {
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step_output" } }
  },
  "$defs": {
    "card_key": { "type": "string", "pattern": "^#c[1-9][0-9]*$" },
    "note_key": { "type": "string", "pattern": "^#n[1-9][0-9]*$" },
    "deck_name": { "type": ["string", "null"] },
    "f32": { "type": "number", "description": "Shortest round-trip f32 decimal (O6)." },
    "step_output": {
      "type": "object",
      "properties": {
        "add_note": {
          "type": "object",
          "required": ["note", "cards"],
          "additionalProperties": false,
          "properties": {
            "note": { "$ref": "#/$defs/note_key" },
            "cards": { "type": "array", "items": { "$ref": "#/$defs/card_key" } }
          }
        },
        "check_db": {
          "description": "specs/conformance/collection-check.md K10: the K5 problem counts, or the rejection corrupt.",
          "anyOf": [
            { "$ref": "#/$defs/check_db_counts" },
            {
              "allOf": [
                { "$ref": "#/$defs/rejection" },
                { "properties": { "error": { "enum": ["corrupt"] } } }
              ]
            }
          ]
        },
        "db_exec": {
          "description": "specs/conformance/record-ops.md W1: the rows the statement returned; [] when none.",
          "type": "object",
          "required": ["rows"],
          "additionalProperties": false,
          "properties": { "rows": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/sql_value" } } } }
        },
        "ids": {
          "type": "object",
          "propertyNames": { "pattern": "^#[nc][1-9][0-9]*$" },
          "additionalProperties": { "type": "integer" }
        },
        "timing": {
          "type": "object",
          "required": ["days_elapsed", "next_day_at", "now", "utc_offset_secs"],
          "additionalProperties": false,
          "properties": {
            "days_elapsed": { "type": "integer" },
            "next_day_at": { "type": "integer" },
            "now": { "type": "integer" },
            "utc_offset_secs": { "type": "integer" }
          }
        },
        "open": {
          "description": "specs/conformance/storage-ops.md P1.2: a successful open records {}, so this member holds only a rejection.",
          "allOf": [
            { "$ref": "#/$defs/rejection" },
            { "properties": { "error": { "enum": ["file_too_old", "file_too_new", "v1_scheduler"] } } }
          ]
        },
        "schema_objects": {
          "description": "storage-ops.md P3: sqlite_master rows sorted by type, then name; sql normalized.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "name", "tbl_name", "sql"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["table", "index", "view", "trigger"] },
              "name": { "type": "string" },
              "tbl_name": { "type": "string" },
              "sql": { "type": ["string", "null"] }
            }
          }
        },
        "card": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/card_key" },
          "additionalProperties": { "anyOf": [{ "$ref": "#/$defs/card_row" }, { "type": "null" }] }
        },
        "revlog": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/card_key" },
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/revlog_row" } }
        },
        "next_states": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/card_key" },
          "additionalProperties": {
            "type": "object",
            "required": ["current", "again", "hard", "good", "easy"],
            "additionalProperties": false,
            "properties": {
              "current": { "$ref": "#/$defs/state" },
              "again": { "$ref": "#/$defs/state" },
              "hard": { "$ref": "#/$defs/state" },
              "good": { "$ref": "#/$defs/state" },
              "easy": { "$ref": "#/$defs/state" }
            }
          }
        },
        "fuzz_table": {
          "type": "object",
          "required": ["intervals", "rows"],
          "additionalProperties": false,
          "properties": {
            "intervals": { "type": "array", "items": { "type": "integer" } },
            "rows": { "type": "array", "items": { "type": "array", "items": { "type": "integer" }, "minItems": 2 } }
          }
        },
        "net_probe": {
          "type": "object",
          "required": ["connected", "error"],
          "additionalProperties": false,
          "properties": { "connected": { "type": "boolean" }, "error": { "type": ["string", "null"] } }
        },
        "legacy_json": {
          "description": "model-ops.md L1: schema-11 objects keyed by record name.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "notetypes": { "type": "object", "additionalProperties": { "type": "object" } },
            "decks": { "type": "object", "additionalProperties": { "type": "object" } },
            "presets": { "type": "object", "additionalProperties": { "type": "object" } }
          }
        },
        "legacy_update": {
          "description": "model-ops.md L2: the op has no output, so only a rejection appears.",
          "allOf": [{ "$ref": "#/$defs/rejection" }, { "properties": { "error": { "enum": ["invalid_json"] } } }]
        },
        "add_notetype": { "description": "notetype-ops.md T2.", "$ref": "#/$defs/notetype_save" },
        "add_stock_notetype": { "description": "notetype-ops.md T3.", "$ref": "#/$defs/notetype_save" },
        "clone_notetype": { "description": "notetype-ops.md T4.", "$ref": "#/$defs/notetype_save" },
        "update_notetype": { "description": "notetype-ops.md T5.", "$ref": "#/$defs/notetype_save" },
        "ensure_io_notetype": {
          "description": "notetype-ops.md T6: the Image Occlusion note type's stored name.",
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": { "name": { "type": "string" } }
        },
        "notetype_structure": {
          "description": "notetype-ops.md T8: note types by stored name, without template text, CSS or ids.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/notetype_structure" }
        },
        "blob_decode": {
          "description": "model-ops.md L4: per record, ok or invalid_blob.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "notetypes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/decode_status" } },
            "decks": { "type": "object", "additionalProperties": { "$ref": "#/$defs/decode_status" } },
            "presets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/decode_status" } }
          }
        },
        "export": {
          "description": "dsl.md D7.2: the legacy package form outputs {notes} (model-ops.md L6); the other forms are draft (package).",
          "type": "object",
          "properties": { "notes": { "type": "integer", "minimum": 0 } }
        },
        "package_col": {
          "description": "model-ops.md L7: the requested col columns of a legacy package's collection; ver an integer, the JSON columns parsed.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "ver": { "type": "integer" },
            "conf": { "type": "object" },
            "models": { "$ref": "#/$defs/objects_by_id" },
            "decks": { "$ref": "#/$defs/objects_by_id" },
            "dconf": { "$ref": "#/$defs/objects_by_id" },
            "tags": { "type": "object", "additionalProperties": { "type": "integer" } }
          }
        },
        "cloze": {
          "description": "specs/conformance/cloze-ops.md Z1: one array per requested function, one output per input in input order.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "numbers": {
              "type": "array",
              "items": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } }
            },
            "front": { "$ref": "#/$defs/text_strings" },
            "back": { "$ref": "#/$defs/text_strings" },
            "only_front": { "$ref": "#/$defs/text_strings" },
            "only_back": { "$ref": "#/$defs/text_strings" },
            "typing": { "$ref": "#/$defs/text_strings" }
          }
        },
        "fsrs_next": {
          "description": "float-determinism.md F3.3, F5.2: one row per input, in input order: days, stability and difficulty for again, hard, good and easy.",
          "type": "object",
          "required": ["rows"],
          "additionalProperties": false,
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  { "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/f32" }, { "$ref": "#/$defs/f32" },
                  { "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/f32" }, { "$ref": "#/$defs/f32" },
                  { "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/f32" }, { "$ref": "#/$defs/f32" },
                  { "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/f32" }, { "$ref": "#/$defs/f32" }
                ],
                "minItems": 12,
                "maxItems": 12
              }
            }
          }
        },
        "text": {
          "description": "O4 text: one array per requested function, one output per input in input order.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "strip_markup": { "$ref": "#/$defs/text_strings" },
            "strip_markup_keep_media": { "$ref": "#/$defs/text_strings" },
            "text_line": { "$ref": "#/$defs/text_strings" },
            "text_line_keep_media": { "$ref": "#/$defs/text_strings" },
            "media_refs": { "type": "array", "items": { "$ref": "#/$defs/text_strings" } },
            "iri_encode": { "$ref": "#/$defs/text_strings" },
            "iri_decode": { "$ref": "#/$defs/text_strings" },
            "media_filename": { "$ref": "#/$defs/text_strings" },
            "sort_field": { "$ref": "#/$defs/text_strings" },
            "checksum": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 } },
            "field_empty": { "type": "array", "items": { "type": "boolean" } },
            "unicase_compare": { "type": "array", "items": { "enum": [-1, 0, 1] } }
          }
        },
        "render_status": {
          "description": "specs/conformance/render-ops.md Q4.3: per card, its stored ordinal and whether it renders for review from its stored templates; null when the card no longer exists.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/card_key" },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "required": ["ord", "status"],
                "additionalProperties": false,
                "properties": {
                  "ord": { "type": "integer", "minimum": 0 },
                  "status": { "enum": ["ok", "empty", "template_error"] }
                }
              },
              { "type": "null" }
            ]
          }
        },
        "template": {
          "description": "specs/conformance/render-ops.md Q1.5: one result per case, in case order.",
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "required": ["question", "answer", "empty"],
                "additionalProperties": false,
                "properties": {
                  "question": { "type": "string" },
                  "answer": { "type": "string" },
                  "empty": { "const": false }
                }
              },
              {
                "type": "object",
                "required": ["question", "answer", "empty"],
                "additionalProperties": false,
                "properties": {
                  "question": { "type": "string" },
                  "answer": { "type": "null" },
                  "empty": { "const": true }
                }
              },
              {
                "type": "object",
                "required": ["error"],
                "additionalProperties": false,
                "properties": {
                  "error": {
                    "type": "object",
                    "required": ["kind", "side"],
                    "additionalProperties": false,
                    "properties": {
                      "kind": { "enum": ["unclosed_conditional", "unopened_conditional", "mismatched_conditional", "unknown_field", "unknown_conditional"] },
                      "side": { "enum": ["question", "answer"] }
                    }
                  }
                }
              }
            ]
          }
        },
        "fields_check": {
          "description": "specs/conformance/note-ops.md N4: one result per case, in case order; duplicates only with the state duplicate.",
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "required": ["state"],
                "additionalProperties": false,
                "properties": {
                  "state": { "enum": ["normal", "empty", "missing_cloze", "notetype_not_cloze", "field_not_cloze"] }
                }
              },
              {
                "type": "object",
                "required": ["state", "duplicates"],
                "additionalProperties": false,
                "properties": {
                  "state": { "const": "duplicate" },
                  "duplicates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/note_key" } }
                }
              }
            ]
          }
        },
        "db_dump": { "$ref": "#/$defs/db_dump" },
        "browser_config": {
          "description": "specs/conformance/browser-config-ops.md B2: the 23 browser and search config keys as Anki's own reads give them; the last eight are stored JSON values of any shape.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "browserTableShowNotesMode", "collapseSavedSearches", "collapseToday", "collapseFlags", "collapseCardState",
            "collapseDecks", "collapseNotetypes", "collapseTags", "previewBothSides", "ignoreAccentsInSearch",
            "restorePositionBrowser", "resetCountsBrowser", "normalize_note_text", "setDueBrowser", "defaultSearchText",
            "activeCols", "activeNoteCols", "sortType", "noteSortType", "sortBackwards", "browserNoteSortBackwards",
            "savedFilters", "flagLabels"
          ],
          "properties": {
            "browserTableShowNotesMode": { "type": "boolean" },
            "collapseSavedSearches": { "type": "boolean" },
            "collapseToday": { "type": "boolean" },
            "collapseFlags": { "type": "boolean" },
            "collapseCardState": { "type": "boolean" },
            "collapseDecks": { "type": "boolean" },
            "collapseNotetypes": { "type": "boolean" },
            "collapseTags": { "type": "boolean" },
            "previewBothSides": { "type": "boolean" },
            "ignoreAccentsInSearch": { "type": "boolean" },
            "restorePositionBrowser": { "type": "boolean" },
            "resetCountsBrowser": { "type": "boolean" },
            "normalize_note_text": { "type": "boolean" },
            "setDueBrowser": { "type": "string" },
            "defaultSearchText": { "type": "string" },
            "activeCols": true,
            "activeNoteCols": true,
            "sortType": true,
            "noteSortType": true,
            "sortBackwards": true,
            "browserNoteSortBackwards": true,
            "savedFilters": true,
            "flagLabels": true
          }
        },
        "add_note_tags": { "description": "specs/conformance/tag-ops.md G1: notes written.", "$ref": "#/$defs/op_count" },
        "remove_note_tags": { "description": "tag-ops.md G2: notes written.", "$ref": "#/$defs/op_count" },
        "delete_tags": { "description": "tag-ops.md G3: notes written.", "$ref": "#/$defs/op_count" },
        "rename_tag": {
          "description": "tag-ops.md G4: notes written, or the rejection invalid_name.",
          "anyOf": [
            { "$ref": "#/$defs/op_count" },
            { "allOf": [{ "$ref": "#/$defs/rejection" }, { "properties": { "error": { "enum": ["invalid_name"] } } }] }
          ]
        },
        "reparent_tags": { "description": "tag-ops.md G5: notes written.", "$ref": "#/$defs/op_count" },
        "clear_unused_tags": { "description": "tag-ops.md G6: registry rows removed.", "$ref": "#/$defs/op_count" },
        "set_flag": {
          "description": "tag-ops.md G8: cards written, or the rejection invalid_flag.",
          "anyOf": [
            { "$ref": "#/$defs/op_count" },
            { "allOf": [{ "$ref": "#/$defs/rejection" }, { "properties": { "error": { "enum": ["invalid_flag"] } } }] }
          ]
        },
        "tag_tree": {
          "description": "tag-ops.md G9: top-level nodes of the tag tree (specs/tags/tags.md T13).",
          "type": "array",
          "items": { "$ref": "#/$defs/tag_node" }
        },
        "undo": {
          "description": "undo-ops.md V1: the op has no output, so only a rejection appears; changed_externally is Meguri's only.",
          "allOf": [{ "$ref": "#/$defs/rejection" }, { "properties": { "error": { "enum": ["nothing_to_undo", "changed_externally"] } } }]
        },
        "redo": {
          "description": "undo-ops.md V1: the op has no output, so only a rejection appears; changed_externally is Meguri's only.",
          "allOf": [{ "$ref": "#/$defs/rejection" }, { "properties": { "error": { "enum": ["nothing_to_redo", "changed_externally"] } } }]
        },
        "undo_status": {
          "description": "undo-ops.md V2: the step an undo and a redo would apply now, or null.",
          "type": "object",
          "required": ["undo", "redo"],
          "additionalProperties": false,
          "properties": {
            "undo": { "anyOf": [{ "$ref": "#/$defs/undo_step" }, { "type": "null" }] },
            "redo": { "anyOf": [{ "$ref": "#/$defs/undo_step" }, { "type": "null" }] }
          }
        },
        "search": {
          "description": "specs/conformance/search-ops.md S1: one output per request, in request order.",
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "required": ["ids"],
                "additionalProperties": false,
                "properties": {
                  "ids": {
                    "description": "#cN (cards mode) or #nN (notes mode) in logical-id order, then real ids of unnamed rows in ascending order.",
                    "type": "array",
                    "items": { "anyOf": [{ "type": "string", "pattern": "^#[nc][1-9][0-9]*$" }, { "type": "integer" }] }
                  }
                }
              },
              { "$ref": "#/$defs/search_error" }
            ]
          }
        },
        "canonical_search": {
          "description": "specs/conformance/search-ops.md S2: one output per query text, in order; parse errors only.",
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "required": ["text"],
                "additionalProperties": false,
                "properties": { "text": { "type": "string" } }
              },
              {
                "allOf": [
                  { "$ref": "#/$defs/search_error" },
                  { "properties": { "error": { "not": { "enum": ["invalid_regex", "search_failed"] } } } }
                ]
              }
            ]
          }
        },
        "sync": {
          "description": "specs/conformance/sync-ops.md S4: a result, or a rejection of the op's closed list.",
          "anyOf": [
            {
              "type": "object",
              "required": ["result"],
              "additionalProperties": false,
              "properties": { "result": { "enum": ["ok", "no_changes", "normal_sync", "full_sync", "full_upload", "full_download"] } }
            },
            {
              "allOf": [
                { "$ref": "#/$defs/rejection" },
                { "properties": { "error": { "enum": ["auth_failed", "clock_incorrect", "network"] } } }
              ]
            }
          ]
        },
        "add_deck": {
          "description": "specs/conformance/deck-ops.md K2: the stored human name of the deck returned, or a rejection.",
          "anyOf": [
            { "type": "object", "required": ["name"], "additionalProperties": false, "properties": { "name": { "type": "string" } } },
            { "allOf": [{ "$ref": "#/$defs/rejection" }, { "properties": { "error": { "enum": ["filtered_parent", "too_deep"] } } }] }
          ]
        },
        "rename_deck": {
          "description": "deck-ops.md K3: the deck's stored human name after the op, or a rejection (under_descendant is Meguri's only).",
          "anyOf": [
            { "type": "object", "required": ["name"], "additionalProperties": false, "properties": { "name": { "type": "string" } } },
            { "allOf": [{ "$ref": "#/$defs/rejection" }, { "properties": { "error": { "enum": ["filtered_parent", "too_deep", "under_descendant"] } } }] }
          ]
        },
        "reparent_decks": {
          "description": "deck-ops.md K4: the number of listed decks that moved, or a rejection.",
          "anyOf": [
            { "type": "object", "required": ["count"], "additionalProperties": false, "properties": { "count": { "type": "integer", "minimum": 0 } } },
            { "allOf": [{ "$ref": "#/$defs/rejection" }, { "properties": { "error": { "enum": ["filtered_parent"] } } }] }
          ]
        },
        "delete_decks": {
          "description": "deck-ops.md K5: the number of cards removed.",
          "type": "object",
          "required": ["count"],
          "additionalProperties": false,
          "properties": { "count": { "type": "integer", "minimum": 0 } }
        },
        "remove_preset": {
          "description": "deck-ops.md K9: the op has no output, so only a rejection appears.",
          "allOf": [{ "$ref": "#/$defs/rejection" }, { "properties": { "error": { "enum": ["default_preset"] } } }]
        },
        "set_deck_preset": {
          "description": "deck-ops.md K10: the op has no output, so only a rejection appears.",
          "allOf": [{ "$ref": "#/$defs/rejection" }, { "properties": { "error": { "enum": ["filtered_deck"] } } }]
        },
        "decks": {
          "description": "deck-ops.md K11: every deck, keyed by its stored name in human form.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["id", "filtered", "config_id", "study_collapsed", "browser_collapsed", "mtime_secs", "usn"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "integer" },
              "filtered": { "type": "boolean" },
              "config_id": { "type": ["integer", "null"] },
              "study_collapsed": { "type": "boolean" },
              "browser_collapsed": { "type": "boolean" },
              "mtime_secs": { "type": "integer" },
              "usn": { "type": "integer" }
            }
          }
        },
        "deck_tree": {
          "description": "deck-ops.md K12: the top-level nodes of the deck tree in order (decks/decks.md D12).",
          "type": "array",
          "items": { "$ref": "#/$defs/deck_tree_node" }
        },
        "converge": {
          "description": "sync-ops.md S7.5.",
          "type": "object",
          "required": ["differences", "dump"],
          "additionalProperties": false,
          "properties": {
            "differences": {
              "description": "Per actor, the pointers into the dump where the actor's raw dump differs from the fresh client's; [] when it converged.",
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/actor_name" },
              "additionalProperties": {
                "type": "array",
                "items": { "type": "string", "pattern": "^(/[^/]*)+$" }
              }
            },
            "dump": { "$ref": "#/$defs/db_dump" }
          }
        }
      }
    },
    "deck_tree_node": {
      "type": "object",
      "required": ["name", "children"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/deck_tree_node" } }
      }
    },
    "text_strings": { "type": "array", "items": { "type": "string" } },
    "op_count": {
      "type": "object",
      "required": ["count"],
      "additionalProperties": false,
      "properties": { "count": { "type": "integer", "minimum": 0 } }
    },
    "tag_node": {
      "type": "object",
      "required": ["name", "collapsed", "children"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "collapsed": { "type": "boolean" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/tag_node" } }
      }
    },
    "undo_step": {
      "description": "undo-ops.md V4: the id of an undo step's name.",
      "enum": [
        "add_deck", "add_note", "add_note_type", "answer_card", "build_deck", "bury", "change_deck", "change_note_type",
        "clear_unused_tags", "custom_study", "deck_options", "delete_deck", "delete_note", "empty", "empty_cards",
        "find_and_replace", "grade_now", "image_occlusion", "import", "preferences", "remove_note_type", "remove_tag",
        "rename_deck", "rename_tag", "reposition", "reset_card", "select_deck", "set_due_date", "set_flag", "suspend",
        "toggle_load_balancer", "unbury_unsuspend", "update_card", "update_config", "update_deck", "update_note",
        "update_note_type", "update_tag"
      ]
    },
    "search_error": {
      "description": "specs/search/errors.md E1 kinds; provided and context per E2, backticks replaced by apostrophes (search-ops.md S3).",
      "type": "object",
      "required": ["error"],
      "additionalProperties": false,
      "properties": {
        "error": {
          "enum": [
            "misplaced_and", "misplaced_or", "empty_group", "unopened_group", "unclosed_group", "empty_quote",
            "unclosed_quote", "missing_key", "unknown_escape", "invalid_state", "invalid_flag", "invalid_property",
            "invalid_operator", "invalid_number", "invalid_whole_number", "invalid_positive_whole_number",
            "invalid_negative_whole_number", "invalid_answer_button", "invalid_id_list", "invalid_dupe", "malformed",
            "invalid_regex", "search_failed"
          ]
        },
        "provided": { "type": "string" },
        "context": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "error": { "enum": ["unknown_escape", "invalid_state", "invalid_property", "invalid_operator"] } } },
          "then": { "required": ["provided"], "not": { "required": ["context"] } }
        },
        {
          "if": {
            "properties": {
              "error": {
                "enum": ["invalid_number", "invalid_whole_number", "invalid_positive_whole_number", "invalid_negative_whole_number", "invalid_answer_button"]
              }
            }
          },
          "then": { "required": ["provided", "context"] }
        },
        {
          "if": { "properties": { "error": { "const": "invalid_id_list" } } },
          "then": { "required": ["context"], "not": { "required": ["provided"] } }
        },
        {
          "if": {
            "properties": {
              "error": {
                "enum": ["misplaced_and", "misplaced_or", "empty_group", "unopened_group", "unclosed_group", "empty_quote", "unclosed_quote", "missing_key", "invalid_flag", "invalid_dupe", "malformed", "invalid_regex", "search_failed"]
              }
            }
          },
          "then": { "properties": { "provided": false, "context": false } }
        }
      ]
    },
    "decode_status": { "enum": ["ok", "invalid_blob"] },
    "objects_by_id": {
      "description": "schema11-json S12: decimal id -> schema-11 object.",
      "type": "object",
      "propertyNames": { "pattern": "^-?[0-9]+$" },
      "additionalProperties": { "type": "object" }
    },
    "actor_name": { "type": "string", "pattern": "^(meguri(_([2-9]|[1-9][0-9]+))?|client_[a-z])$" },
    "db_dump": {
      "description": "observations.md O8: table -> primary key text -> column -> value.",
      "type": "object",
      "propertyNames": {
        "enum": ["col", "notes", "cards", "revlog", "graves", "decks", "deck_config", "notetypes", "fields", "templates", "tags", "config"]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/dump_value" }
        }
      }
    },
    "dump_value": {
      "description": "By SQLite storage class: INTEGER integer, REAL number, TEXT string, NULL null, BLOB {sha256}.",
      "anyOf": [
        { "type": ["integer", "number", "string", "null"] },
        {
          "type": "object",
          "required": ["sha256"],
          "additionalProperties": false,
          "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
        }
      ]
    },
    "notetype_save": {
      "description": "notetype-ops.md T2-T5: the stored name, or a rejection of T7.",
      "anyOf": [
        {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": { "name": { "type": "string" } }
        },
        {
          "allOf": [
            { "$ref": "#/$defs/rejection" },
            {
              "properties": {
                "error": {
                  "enum": ["invalid_notetype", "template_parse_error", "duplicate_front", "no_front_field", "unknown_field", "missing_cloze"]
                }
              }
            }
          ]
        }
      ]
    },
    "notetype_structure": {
      "description": "notetype-ops.md T8.",
      "type": "object",
      "required": ["kind", "original_stock_kind", "original_id", "sort_field", "fields", "templates"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["standard", "cloze"] },
        "original_stock_kind": { "type": "integer" },
        "original_id": { "type": ["integer", "null"] },
        "sort_field": { "type": "integer", "minimum": 0 },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name", "sticky", "rtl", "font_name", "font_size", "description", "plain_text", "collapsed",
              "exclude_from_search", "tag", "prevent_deletion"
            ],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "sticky": { "type": "boolean" },
              "rtl": { "type": "boolean" },
              "font_name": { "type": "string" },
              "font_size": { "type": "integer", "minimum": 0 },
              "description": { "type": "string" },
              "plain_text": { "type": "boolean" },
              "collapsed": { "type": "boolean" },
              "exclude_from_search": { "type": "boolean" },
              "tag": { "type": ["integer", "null"] },
              "prevent_deletion": { "type": "boolean" }
            }
          }
        },
        "templates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "deck", "requirement"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "deck": { "type": ["string", "integer", "null"] },
              "requirement": {
                "anyOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "required": ["kind", "fields"],
                    "additionalProperties": false,
                    "properties": {
                      "kind": { "enum": ["none", "any", "all"] },
                      "fields": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "rejection": {
      "description": "An op Anki refused (dsl.md D7.3). An op whose D7.2 row lists rejection kinds takes anyOf [its output, this with error restricted to those kinds]; the others record none.",
      "type": "object",
      "required": ["error"],
      "additionalProperties": false,
      "properties": { "error": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
    },
    "card_row": {
      "type": "object",
      "required": ["id", "nid", "did", "ord", "mod", "usn", "type", "queue", "due", "ivl", "factor", "reps", "lapses", "left", "odue", "odid", "flags", "data"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/card_key" },
        "nid": { "type": "string" },
        "did": { "$ref": "#/$defs/deck_name" },
        "odid": { "$ref": "#/$defs/deck_name" },
        "ord": { "type": "integer" },
        "mod": { "type": "integer" },
        "usn": { "type": "integer" },
        "type": { "type": "integer" },
        "queue": { "type": "integer" },
        "due": { "type": "integer" },
        "ivl": { "type": "integer" },
        "factor": { "type": "integer" },
        "reps": { "type": "integer" },
        "lapses": { "type": "integer" },
        "left": { "type": "integer" },
        "odue": { "type": "integer" },
        "flags": { "type": "integer" },
        "data": { "type": ["object", "string"] }
      }
    },
    "revlog_row": {
      "type": "object",
      "required": ["id", "cid", "usn", "ease", "ivl", "lastIvl", "factor", "time", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer" },
        "cid": { "type": "string" },
        "usn": { "type": "integer" },
        "ease": { "type": "integer" },
        "ivl": { "type": "integer" },
        "lastIvl": { "type": "integer" },
        "factor": { "type": "integer" },
        "time": { "type": "integer" },
        "type": { "type": "integer" }
      }
    },
    "memory_state": {
      "type": "object",
      "required": ["stability", "difficulty"],
      "additionalProperties": false,
      "properties": { "stability": { "$ref": "#/$defs/f32" }, "difficulty": { "$ref": "#/$defs/f32" } }
    },
    "learning_fields": {
      "type": "object",
      "required": ["remaining_steps", "scheduled_secs", "elapsed_secs"],
      "properties": {
        "remaining_steps": { "type": "integer" },
        "scheduled_secs": { "type": "integer" },
        "elapsed_secs": { "type": "integer" },
        "memory_state": { "$ref": "#/$defs/memory_state" }
      }
    },
    "review_fields": {
      "type": "object",
      "required": ["scheduled_days", "elapsed_days", "ease_factor", "lapses", "leeched"],
      "properties": {
        "scheduled_days": { "type": "integer" },
        "elapsed_days": { "type": "integer" },
        "ease_factor": { "$ref": "#/$defs/f32" },
        "lapses": { "type": "integer" },
        "leeched": { "type": "boolean" },
        "memory_state": { "$ref": "#/$defs/memory_state" }
      }
    },
    "state": {
      "description": "A flattened scheduling state (O5).",
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["new", "learning", "review", "relearning", "preview", "rescheduling"] }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "new" } } },
          "then": { "required": ["position"], "properties": { "position": { "type": "integer" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "learning" } } },
          "then": { "$ref": "#/$defs/learning_fields" }
        },
        {
          "if": { "properties": { "kind": { "const": "review" } } },
          "then": { "$ref": "#/$defs/review_fields" }
        },
        {
          "if": { "properties": { "kind": { "const": "relearning" } } },
          "then": {
            "required": ["learning", "review"],
            "properties": { "learning": { "$ref": "#/$defs/learning_fields" }, "review": { "$ref": "#/$defs/review_fields" } }
          }
        }
      ]
    },
    "check_db_counts": {
      "description": "collection-check.md K5: every kind present, 0 when Anki reported none of it; notetypes_recovered is 1 when reported (its message has no number).",
      "type": "object",
      "required": ["card_properties", "new_positions_too_high", "card_last_review_time", "cards_without_note", "decks_missing", "field_counts", "duplicate_card_ords", "cards_without_template", "revlog_properties", "notes_invalid_utf8", "future_ids", "notetypes_recovered"],
      "additionalProperties": false,
      "properties": {
        "card_properties": { "type": "integer", "minimum": 0 },
        "new_positions_too_high": { "type": "integer", "minimum": 0 },
        "card_last_review_time": { "type": "integer", "minimum": 0 },
        "cards_without_note": { "type": "integer", "minimum": 0 },
        "decks_missing": { "type": "integer", "minimum": 0 },
        "field_counts": { "type": "integer", "minimum": 0 },
        "duplicate_card_ords": { "type": "integer", "minimum": 0 },
        "cards_without_template": { "type": "integer", "minimum": 0 },
        "revlog_properties": { "type": "integer", "minimum": 0 },
        "notes_invalid_utf8": { "type": "integer", "minimum": 0 },
        "future_ids": { "type": "integer", "minimum": 0 },
        "notetypes_recovered": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    },
    "sql_value": {
      "description": "record-ops.md W1, by SQLite storage class: INTEGER integer, REAL number, TEXT string, NULL null, BLOB {sha256}.",
      "anyOf": [
        { "type": ["integer", "number", "string", "null"] },
        {
          "type": "object",
          "required": ["sha256"],
          "additionalProperties": false,
          "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
        }
      ]
    }
  }
}
