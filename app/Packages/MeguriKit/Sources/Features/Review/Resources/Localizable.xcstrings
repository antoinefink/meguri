    "review.leech.tagged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card you answered in this session has been forgotten many times: it reached its deck’s leech threshold. Its note is now tagged “leech”, so you can find it in Browse and rework it."
          }
        }
      }
    },
    "review.leech.suspended": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card you answered in this session has been forgotten many times: it reached its deck’s leech threshold. Its note is now tagged “leech”, and the card is suspended: it will not come up again until you unsuspend it."
          }
        }
      }
    }
  },
