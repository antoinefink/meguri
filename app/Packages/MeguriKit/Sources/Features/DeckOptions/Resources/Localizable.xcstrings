    "deckOptions.issue.notWhole": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a whole number."
          }
        }
      }
    },
    "deckOptions.issue.outOfRange.number": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a number from %1$@ to %2$@."
          }
        }
      }
    },
    "deckOptions.issue.outOfRange.percent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a percentage from %1$@ to %2$@."
          }
        }
      }
    },
    "deckOptions.issue.retentionHigh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A higher desired retention means many more reviews."
          }
        }
      }
    },
    "deckOptions.issue.retentionHigh.strong": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A desired retention this high means a very large number of reviews."
          }
        }
      }
    },
    "deckOptions.issue.retentionLow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a lower desired retention, you’ll forget more cards."
          }
        }
      }
    },
    "deckOptions.issue.retentionLow.strong": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a desired retention this low, you’ll forget many of your cards."
          }
        }
      }
    },
    "deckOptions.issue.reviewsBelowTenTimesNew": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use %@ or more reviews per day to keep up with your new cards."
          }
        }
      }
    },
    "deckOptions.preset.usedBy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (used by %#@decks@)"
          },
          "substitutions": {
            "decks": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%3$@ deck"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%3$@ decks"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "deckOptions.saveFailed.busy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The collection is busy. Finish the current operation, then try again."
