    "Login only saves a device-only login key. It does not prepare or transfer a collection. The password is not saved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Login only saves a device-only login key. It does not prepare or transfer a collection. The password is not saved."
          }
        }
      }
    },
    "This history loads offline. Restart never resumes a server request. Safety copies contain collection data, without media. A copy saved below is independent of the retained original; unverified files must be inspected before use.": {
