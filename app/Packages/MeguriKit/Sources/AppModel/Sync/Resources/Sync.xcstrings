    "sync.attention.mediaChanged": {
      "comment": "Approved sync/status-strings copy; displayed only for the corresponding typed backend fact.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld media file changed while it was syncing. It syncs after Meguri checks it again."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld media files changed while they were syncing. They sync after Meguri checks them again."
                }
              }
            }
          }
        }
      }
    },
    "sync.attention.mediaMissing": {
