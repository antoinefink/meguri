      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server’s collection changed after you chose. Choose again."
          }
        }
      }
    },
    "sync.meguri.setup.error.localChanged": {
      "comment": "Approved sync/status-strings T18; shown only for the corresponding local or typed Core fact.",
