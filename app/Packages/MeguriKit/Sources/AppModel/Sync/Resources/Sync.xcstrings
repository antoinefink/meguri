    "sync.attention.adoptUnproven": {
      "comment": "Approved sync/status-strings copy; displayed only for the corresponding typed backend fact.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meguri couldn’t confirm which collection file is current, so syncing stopped."
          }
        }
      }
    },
    "sync.attention.applyFailed": {
      "comment": "Approved sync/status-strings copy; displayed only for the corresponding typed backend fact.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld change from iCloud couldn’t be applied. Meguri tries again later."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld changes from iCloud couldn’t be applied. Meguri tries again later."
                }
              }
            }
          }
        }
      }
    },
    "sync.attention.assetUnavailable": {
      "comment": "Approved sync/status-strings copy; displayed only for the corresponding typed backend fact.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld change from iCloud couldn’t be downloaded. Meguri tries again the next time the collection opens."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld changes from iCloud couldn’t be downloaded. Meguri tries again the next time the collection opens."
