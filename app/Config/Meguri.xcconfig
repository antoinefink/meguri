// The Meguri app target (iOS, iPadOS, macOS). Configuration-specific values
// come from the project level (Debug.xcconfig, ...).

PRODUCT_NAME = Meguri
PRODUCT_BUNDLE_IDENTIFIER = $(MEGURI_BUNDLE_ID)
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor

// Info.plist: the generated keys merged into the per-platform file, which
// holds the keys other areas rely on (R499, R1629, KTD12), the `meguri` URL
// scheme (R319; never `anki`, R321) and, on iOS, the one-scene manifest (R7).
// Every orientation, and no UIRequiresFullScreen: windows resize on iPad and
// iPhone (R7, R8).
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE[sdk=iphone*] = Meguri/Info-iOS.plist
INFOPLIST_FILE[sdk=macosx*] = Meguri/Info-macOS.plist
INFOPLIST_KEY_CFBundleDisplayName = Meguri
// Explicit distribution policy, including personal Release without hooks.
INFOPLIST_KEY_MeguriCardInspectionBuild = $(MEGURI_CARD_INSPECTION_BUILD)
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.education
// Debug builds start every Mac launch as a UI element (no Dock tile, never
// reported Foreground); MeguriApp gives a launch the regular policy unless it
// is a test host or a hidden tools/mg launch (U8d, TestHooks/BackgroundLaunch.swift).
// The others write LSUIElement false: an empty value is not left out either.
INFOPLIST_KEY_LSUIElement[sdk=macosx*] = $(MEGURI_MAC_UI_ELEMENT)
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphone*] = YES
INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphone*] = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight

// Entitlements (R2041, KTD22). Mac: Meguri-macOS[-Dev][-AdHoc].entitlements,
// -Dev for hook builds, -AdHoc without a signing team (Signing.xcconfig).
CODE_SIGN_ENTITLEMENTS[sdk=iphone*] = Meguri/Meguri-iOS.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = Meguri/Meguri-macOS$(MEGURI_ENTITLEMENTS_HOOKS_SUFFIX)$(MEGURI_ENTITLEMENTS_SIGNING_SUFFIX).entitlements

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
LD_RUNPATH_SEARCH_PATHS[sdk=macosx*] = $(inherited) @executable_path/../Frameworks
