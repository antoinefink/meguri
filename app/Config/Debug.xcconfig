// Debug: development builds. Test hooks and AnkiWeb on; `.dev` identifiers.

#include "Base.xcconfig"

MEGURI_BUNDLE_ID_SUFFIX = .dev
MEGURI_CLOUD_CONFIGURATION = development
MEGURI_SWIFT_CONDITIONS = DEBUG MEGURI_TEST_HOOKS ANKIWEB_ENABLED
MEGURI_CORE_FEATURES = ankiweb,test-hooks
MEGURI_CARD_INSPECTION_BUILD = debug
// Hook builds read fixtures from the checkout on the Mac (FixtureInstaller).
MEGURI_ENTITLEMENTS_HOOKS_SUFFIX = -Dev
// The Mac app starts as a UI element (U8d): see Meguri.xcconfig. Debug only:
// Profile keeps Release's launch for performance runs (R1866).
MEGURI_MAC_UI_ELEMENT = YES

GCC_PREPROCESSOR_DEFINITIONS = DEBUG=1 $(inherited)
SWIFT_OPTIMIZATION_LEVEL = -Onone
GCC_OPTIMIZATION_LEVEL = 0
GCC_DYNAMIC_NO_PIC = NO
ONLY_ACTIVE_ARCH = YES
DEBUG_INFORMATION_FORMAT = dwarf
ENABLE_TESTABILITY = YES
ENABLE_PREVIEWS = YES
MTL_ENABLE_DEBUG_INFO = INCLUDE_SOURCE
