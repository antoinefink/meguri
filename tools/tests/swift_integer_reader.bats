#!/usr/bin/env bats
# Generation-only checks; native converter coverage lives in MeguriCore.
bats_require_minimum_version 1.5.0

setup() {
  HELPER="$BATS_TEST_DIRNAME/../scripts/repair-swift-integer-reader.py"
  SWIFT="$BATS_TEST_TMPDIR/generated.swift"
  cat >"$BATS_TEST_TMPDIR/prefix" <<'EOF'
// Surrounding generated bytes: é猫
import Foundation

EOF
  cat >"$BATS_TEST_TMPDIR/old" <<'EOF'
fileprivate func readInt<T: FixedWidthInteger>(_ reader: inout (data: Data, offset: Data.Index)) throws -> T {
    let range = reader.offset..<reader.offset + MemoryLayout<T>.size
    guard reader.data.count >= range.upperBound else {
        throw UniffiInternalError.bufferOverflow
    }
    if T.self == UInt8.self {
        let value = reader.data[reader.offset]
        reader.offset += 1
        return value as! T
    }
    var value: T = 0
    let _ = withUnsafeMutableBytes(of: &value, { reader.data.copyBytes(to: $0, from: range)})
    reader.offset = range.upperBound
    return value.bigEndian
}
EOF
  cat >"$BATS_TEST_TMPDIR/suffix" <<'EOF'

// Comments between generated helpers must remain byte-identical: é猫.
fileprivate func readBytes(_ reader: inout (data: Data, offset: Data.Index), count: Int) throws -> [UInt8] {
    // This helper and all following bytes must remain unchanged.
    return []
}
EOF
  cat "$BATS_TEST_TMPDIR/prefix" "$BATS_TEST_TMPDIR/old" "$BATS_TEST_TMPDIR/suffix" >"$SWIFT"
}

@test "Swift integer repair replaces only the expected helper bytes" {
  cat >"$BATS_TEST_TMPDIR/new" <<'EOF'
fileprivate func readInt<T: FixedWidthInteger & BitwiseCopyable>(_ reader: inout (data: Data, offset: Data.Index)) throws -> T {
    // RustBuffer readers use zero-based Data; raw-buffer offsets are relative.
    guard reader.data.startIndex == 0 else {
        throw UniffiInternalError.bufferOverflow
    }
    let offset = reader.offset
    let size = MemoryLayout<T>.size
    guard offset >= 0, offset <= reader.data.count,
          size <= reader.data.count - offset else {
        throw UniffiInternalError.bufferOverflow
    }
    let value = reader.data.withUnsafeBytes { (bytes: UnsafeRawBufferPointer) in
        bytes.loadUnaligned(fromByteOffset: offset, as: T.self)
    }
    reader.offset = offset + size
    return value.bigEndian
}
EOF
  cat "$BATS_TEST_TMPDIR/prefix" "$BATS_TEST_TMPDIR/new" "$BATS_TEST_TMPDIR/suffix" >"$BATS_TEST_TMPDIR/expected"
  run python3 "$HELPER" "$SWIFT"
  [ "$status" -eq 0 ]
  cmp "$SWIFT" "$BATS_TEST_TMPDIR/expected"
  # A second repair must fail closed, not silently accept already changed input.
  run python3 "$HELPER" "$SWIFT"
  [ "$status" -ne 0 ]
  cmp "$SWIFT" "$BATS_TEST_TMPDIR/expected"
}

@test "Swift integer repair refuses missing or duplicate helper without writing" {
  cp "$SWIFT" "$BATS_TEST_TMPDIR/original"
  for shape in missing duplicate missing-next duplicate-next; do
    case "$shape" in
      missing) cat "$BATS_TEST_TMPDIR/prefix" "$BATS_TEST_TMPDIR/suffix" >"$SWIFT" ;;
      duplicate) cat "$BATS_TEST_TMPDIR/original" "$BATS_TEST_TMPDIR/old" >"$SWIFT" ;;
      missing-next) cat "$BATS_TEST_TMPDIR/prefix" "$BATS_TEST_TMPDIR/old" >"$SWIFT" ;;
      duplicate-next) cat "$BATS_TEST_TMPDIR/original" "$BATS_TEST_TMPDIR/suffix" >"$SWIFT" ;;
    esac
    cp "$SWIFT" "$BATS_TEST_TMPDIR/before"
    run python3 "$HELPER" "$SWIFT"
    [ "$status" -ne 0 ]
    [[ "$output" == *"repair refused"* ]]
    cmp "$SWIFT" "$BATS_TEST_TMPDIR/before"
  done
}

@test "Swift integer repair refuses generator signature or body drift without writing" {
  cp "$SWIFT" "$BATS_TEST_TMPDIR/original"
  for change in 's/FixedWidthInteger/BinaryInteger/' 's/copyBytes/changedCopyBytes/' 's/value.bigEndian/value.littleEndian/' 's/var value: T = 0/var value: T = 1/'; do
    sed "$change" "$BATS_TEST_TMPDIR/original" >"$SWIFT"
    cp "$SWIFT" "$BATS_TEST_TMPDIR/before"
    run python3 "$HELPER" "$SWIFT"
    [ "$status" -ne 0 ]
    [[ "$output" == *"repair refused"* ]]
    cmp "$SWIFT" "$BATS_TEST_TMPDIR/before"
  done
}
