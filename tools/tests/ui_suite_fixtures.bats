#!/usr/bin/env bats
# mg_ui_suite_fixtures (mac-vm.sh): ui-test and a11y find the recipe fixtures
# their selected MeguriUITests classes launch with, generate a missing one
# with the nested fixtures job, and stage each in the VM at its own path, so
# a new worktree runs the same suites as the main checkout.

bats_require_minimum_version 1.5.0

REPO_ROOT="$(cd "$BATS_TEST_DIRNAME/../.." && pwd)"

setup() {
  ROOT="$BATS_TEST_TMPDIR/checkout"
  LOG="$BATS_TEST_TMPDIR/log"
  : >"$LOG"
  mkdir -p "$ROOT/app/MeguriUITests/Journeys" "$ROOT/tools"
  cat >"$ROOT/app/MeguriUITests/HomeTests.swift" <<'EOF'
final class HomeTests: XCTestCase {
    func testA() { _ = root.appending(path: "build/fixtures/recipes/local-review-1") }
}
EOF
  cat >"$ROOT/app/MeguriUITests/Journeys/Owned.swift" <<'EOF'
@MainActor final class OwnedTests: XCTestCase {
    let a = "build/fixtures/recipes/local-review-1"
    let b = "build/fixtures/recipes/owned-sync-review-1"
}
EOF
  cat >"$ROOT/app/MeguriUITests/PlainTests.swift" <<'EOF'
final class PlainTests: XCTestCase {}
EOF
  cat >"$ROOT/app/MeguriUITests/Extra.swift" <<'EOF'
final class HomeTestsExtra: XCTestCase { let c = "build/fixtures/recipes/typical-1" }
EOF
  # The nested fixtures job: makes the recipe unless FAIL_FIXTURES is set.
  cat >"$ROOT/tools/mg" <<EOF
#!/bin/bash
echo "nested \$*" >>"$LOG"
[ -z "\${FAIL_FIXTURES:-}" ] || exit 1
mkdir -p "$ROOT/build/fixtures/recipes/\$2-\$4"
echo "$ROOT/build/mg/fixtures/x/result.json"
EOF
  chmod +x "$ROOT/tools/mg"
}

run_helper() {
  run --separate-stderr bash -c '
    MG_ROOT="$1" MG_TOOLS="$1/tools" MG_JOB=ui-test LOG="$2"; shift 2
    source "'"$REPO_ROOT"'/tools/mg.d/mac-vm.sh"
    mg_failure() { echo "failure $1: $2" >>"$LOG"; }
    mg_message() { echo "message $1" >>"$LOG"; }
    mg_vm_fixture() { echo "stage $1" >>"$LOG"; [ -z "${QUEUE_STAGE:-}" ] || return 2; }
    mg_ui_suite_fixtures "$@" || exit 11
    mg_ui_suite_fixtures_stage "${RUNNER:-vm}" || exit $((20 + $?))
  ' _ "$ROOT" "$LOG" "$@"
}

@test "a selected class's recipe fixture is staged at its own path; Class/method selects its class" {
  mkdir -p "$ROOT/build/fixtures/recipes/local-review-1"
  run_helper HomeTests/testA PlainTests
  [ "$status" -eq 0 ]
  [ "$(cat "$LOG")" = "stage $ROOT/build/fixtures/recipes/local-review-1" ]
}

@test "the class name matches whole words only and the owned journey's fixture is left to it" {
  mkdir -p "$ROOT/build/fixtures/recipes/local-review-1"
  run_helper OwnedTests HomeTests
  [ "$status" -eq 0 ]
  # once, though both classes use it; typical-1 (HomeTestsExtra) is not selected
  [ "$(cat "$LOG")" = "stage $ROOT/build/fixtures/recipes/local-review-1" ]
}

@test "a missing fixture is generated by the nested fixtures job before staging" {
  run_helper HomeTests
  [ "$status" -eq 0 ]
  grep -qx "nested fixtures local-review --seed 1" "$LOG"
  grep -qx "stage $ROOT/build/fixtures/recipes/local-review-1" "$LOG"
}

@test "a fixture that cannot be generated fails before anything is staged and names the command" {
  FAIL_FIXTURES=1 run_helper HomeTests
  [ "$status" -eq 11 ]
  grep -q "failure fixture: .*tools/mg fixtures local-review --seed 1" "$LOG"
  ! grep -q '^stage ' "$LOG"
}

@test "suites without recipe fixtures stage nothing, and nothing is staged on this Mac's runner" {
  run_helper PlainTests
  [ "$status" -eq 0 ]
  [ ! -s "$LOG" ]
  mkdir -p "$ROOT/build/fixtures/recipes/local-review-1"
  RUNNER=host run_helper HomeTests
  [ "$status" -eq 0 ]
  [ ! -s "$LOG" ]
}

@test "an unreachable VM while staging is returned as queued" {
  mkdir -p "$ROOT/build/fixtures/recipes/local-review-1"
  QUEUE_STAGE=1 run_helper HomeTests
  [ "$status" -eq 22 ]
}
