   "launch": {
    "locale": "en_US",
    "animations": false,
    "windowSize": "1250x1000",
    "route": "stats/chart/knowledge-over-time",
    "arguments": [
     "-MeguriAppearance",
     "light"
    ]
   }
  },
  {
   "wait": {
    "id": "stats.page.content",
    "timeout": 40
   }
  },
  {
   "do": "sleep:3"
  },
  {
