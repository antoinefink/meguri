{
  "name": "home-compact-held-loading",
  "description": "Capture the cold production compact deck list first, then a selected detail with its synthetic save held for the fixture lifetime. No collection is opened.",
  "platforms": ["ios"],
  "steps": [
    {"launch": {"route": "navigation/feedback-cold", "animations": false}},
    {"wait": {"activity": "Loading Decks"}},
    {"snapshot": "compact-cold-deck-list"},
    {"launch": {"route": "navigation/feedback", "animations": false}},
    {"wait": "home.deck.row.1700000000101"},
    {"tap": "home.deck.row.1700000000101"},
    {"wait": {"activity": "Loading Deck"}},
    {"snapshot": "compact-deck-held-loading"},
    {"do": "sleep:10"},
    {"wait": {"activity": "Loading Deck"}},
    {"snapshot": "compact-deck-still-held-loading"}
  ]
}
