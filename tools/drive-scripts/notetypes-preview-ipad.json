{
 "name": "preview-ipad",
 "description": "Note Types Cards tab captures, iPad",
 "platforms": [
  "ios"
 ],
 "steps": [
  {
   "launch": {
    "route": "notetypes/cards/preview-back",
    "animations": false
   }
  },
  {
   "wait": {
    "id": "noteTypes.cards.preview.page",
    "timeout": 40
   }
  },
  {
   "do": "sleep:1"
  },
  {
   "snapshot": "ipad-light-back"
  },
  {
   "launch": {
    "route": "notetypes/cards/card-text",
    "animations": false
   }
  },
  {
   "wait": {
    "id": "noteTypes.cards.preview.page",
    "timeout": 40
   }
  },
  {
   "do": "sleep:1"
  },
  {
   "snapshot": "ipad-light-card-text"
  },
  {
   "launch": {
    "route": "notetypes/cards/preview-back",
    "animations": false
   }
  },
  {
   "do": "appearance:dark"
  },
  {
   "wait": {
    "id": "noteTypes.cards.preview.page",
    "timeout": 40
   }
  },
  {
   "do": "sleep:1"
  },
  {
   "snapshot": "ipad-dark-back"
  },
  {
   "launch": {
    "route": "notetypes/cards/card-text",
    "animations": false
   }
  },
  {
   "do": "appearance:dark"
  },
  {
   "wait": {
    "id": "noteTypes.cards.preview.page",
    "timeout": 40
   }
  },
  {
   "do": "sleep:1"
  },
  {
   "snapshot": "ipad-dark-card-text"
  }
 ]
}