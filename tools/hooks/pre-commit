#!/bin/bash
# pre-commit hook: the private-token scan (U15, R1940). `tools/mg hooks
# install` and `tools/mg worktree new` install a shim that runs this file
# from the checkout being committed in; tools/hooks/pre-merge-commit runs it
# for the merges `git merge` commits itself.
#
# The token set is built from the user's collection by `tools/mg private
# copy` and lives in the main checkout's build/private/tokens/, the one set
# every worktree reads (a checkout's own build/private/tokens/ counts too).
# A clone of a machine without the collection has none and the hook does
# nothing there. Where one is expected (`tools/mg private copy` set
# meguri.privateTokenSet=required in the repository's config, or the main
# checkout or this one holds local-data/anki) a missing, empty or unreadable
# set blocks the commit: an unscanned commit is not a clean one.
# With one, the lines this commit adds (binary files whole) must hold none of
# its tokens; tools/scripts/private-scan/private_scan.py scans them. The hook
# names files and line numbers, never a token. A merge commit is scanned
# like any other, against its first parent: a conflict resolution can add
# text neither parent had, and the other parent's lines may have been
# committed without the hook (--no-verify, another clone). Runs under macOS
# /bin/bash 3.2.

set -u

reject() {
  echo "pre-commit: $*" >&2
  exit 1
}

top="$(git rev-parse --show-toplevel)" || exit 1
common="$(git rev-parse --path-format=absolute --git-common-dir)" || exit 1
main="$(dirname "$common")"

# Whether this machine is expected to hold a token set. -e only stats the
# folder; nothing under local-data/ is opened.
required=false
[ "$(git config --get meguri.privateTokenSet 2>/dev/null)" = required ] && required=true
for dir in "$main" "$top"; do
  { [ -e "$dir/local-data/anki" ] || [ -L "$dir/local-data/anki" ]; } && required=true
done

args=()
for dir in "$main" "$top"; do
  f="$dir/build/private/tokens/tokens.txt"
  [ "${#args[@]}" -gt 0 ] && [ "${args[1]}" = "$f" ] && continue
  if [ -e "$f" ] || [ -L "$f" ]; then
    { [ -f "$f" ] && [ ! -L "$f" ] && [ -r "$f" ] && [ -s "$f" ]; } ||
      reject "the private token set $f is not a readable, non-empty regular file, so the staged lines cannot be scanned (R1940); tools/mg doctor (private-scan) says what is wrong"
  elif [ "$dir" != "$main" ] || [ "$required" != true ]; then
    continue
  else
    reject "this repository is expected to have a private token set, but $f is missing or cannot be seen from this session, so the staged lines cannot be scanned (R1940); build it with tools/mg private copy in the main checkout, or commit from a session that can read it (tools/mg doctor, private-scan)"
  fi
  args[${#args[@]}]=--tokens
  args[${#args[@]}]="$f"
done
[ "${#args[@]}" -gt 0 ] || exit 0

command -v python3 >/dev/null 2>&1 ||
  reject "a private token set exists but python3 is not on PATH, so the staged lines cannot be scanned (R1940)"
command -v jq >/dev/null 2>&1 ||
  reject "a private token set exists but jq is not on PATH, so the scan cannot be reported (R1940)"

out="$(python3 -I -B "$top/tools/scripts/private-scan/private_scan.py" scan "${args[@]}" --staged --repo "$top")"
rc=$?
case "$rc" in
  0) exit 0 ;;
  1)
    {
      echo "pre-commit: staged lines hold a word, deck name, tag or media name from the user's private collection (R1940):"
      jq -r '.files[] | "  " + .path + (if .binary then " (binary file)" else " (line " + (.lines | map(tostring) | join(", ")) + ")" end) + (if .stale_public_artifact then " [reviewed public file whose bytes changed since its review]" else "" end)' <<<"$out"
      echo "Remove that text: committed results from the private collection hold only aggregates and logical ids."
      if jq -e 'any(.files[]; .stale_public_artifact)' <<<"$out" >/dev/null; then
        echo "A file marked [reviewed public file ...] was admitted whole by a public review (PUBLIC_ARTIFACTS) and edited since, so its"
        echo "old lines count again when a commit or merge adds them here: docs/process/provenance.md#one-answer-in-every-checkout."
      fi
      echo "The hook never names the token. Check again with: tools/mg private scan-outputs"
    } >&2
    exit 1
    ;;
  *) reject "the private-token scan failed (exit $rc); the commit is blocked until it runs" ;;
esac
