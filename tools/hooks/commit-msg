#!/bin/bash
# commit-msg hook: provenance trailers (U2, R1958). `tools/mg hooks install`
# and `tools/mg worktree new` install a shim that runs this file from the
# checkout being committed in.
#
# - A Role: trailer, when present, names one known role.
# - Commits touching core/, app/, server/ or conformance/runner/ need a Role: trailer.
# - Implementer and fixer commits touching those paths also need Spec: (one
#   or more spec ids, specs/README-format.md, or Product Contract requirement
#   ids such as R1987 for UI work no spec covers) and Session: (the session id
#   from docs/process/provenance/sessions.jsonl).
# Merge commits are not checked. Runs under macOS /bin/bash 3.2.
#
# `commit-msg --commit <rev>` applies the same rules to a commit already made
# (its message and the paths it changes): the merge gate's trailer check over
# a branch (tools/gate/static-checks/trailers.sh), which catches --no-verify
# commits and message-only amends.

set -u
set -f # spec ids are words, never globs

ROLES="spec-writer implementer fixer oracle-maintainer infra critic integrator"
DOC="see docs/process/provenance.md"

reject() {
  echo "commit-msg: $*; $DOC" >&2
  exit 1
}

commit=""
if [ "${1:-}" = --commit ]; then
  commit="${2:?usage: commit-msg --commit <rev>}"
  commit="$(git rev-parse --verify -q "$commit^{commit}")" || reject "'$2' is not a commit"
  [ "$(git rev-list --parents -n 1 "$commit" | wc -w | tr -d ' ')" -le 2 ] || exit 0
  trailers="$(git log -1 --format=%B "$commit" | git stripspace --strip-comments | git interpret-trailers --parse)"
else
  msg="${1:?usage: commit-msg <message file>}"
  git_dir="$(git rev-parse --absolute-git-dir)" || exit 1
  [ -f "$git_dir/MERGE_HEAD" ] && exit 0
  trailers="$(git stripspace --strip-comments <"$msg" | git interpret-trailers --parse)"
fi

# values <key>: the values of every trailer with this key (case-insensitive).
values() {
  printf '%s\n' "$trailers" | awk -v key="$1" '
    { i = index($0, ":"); if (i == 0) next
      k = tolower(substr($0, 1, i - 1)); v = substr($0, i + 1)
      sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v)
      if (k == tolower(key)) print v }'
}

roles="$(values Role)"
role=""
if [ -n "$roles" ]; then
  if [ "$(printf '%s\n' "$roles" | sort -u | wc -l | tr -d ' ')" -ne 1 ]; then
    reject "one Role: trailer per commit, found: $(printf '%s' "$roles" | tr '\n' ' ')"
  fi
  role="$(printf '%s\n' "$roles" | head -n 1)"
  known=no
  for r in $ROLES; do
    [ "$role" = "$r" ] && known=yes
  done
  [ "$known" = yes ] || reject "unknown Role: '$role' (one of: $ROLES)"
fi

# NUL-separated, so git does not quote (and hide) non-ASCII or tab names.
# No rename detection: a move out of core/ must still list its core/ source.
changed_paths() {
  if [ -n "$commit" ]; then
    git diff-tree --root --no-commit-id -r --no-renames --name-only -z "$commit"
  else
    git diff --cached --no-renames --name-only -z
  fi
}
code_paths="$(changed_paths | tr '\0' '\n' | grep -E '^(core/|app/|server/|conformance/runner/)' | head -n 3)"
[ -n "$code_paths" ] || exit 0
first_path="$(printf '%s\n' "$code_paths" | head -n 1)"

[ -n "$role" ] || reject "commits touching core/, app/, server/ or conformance/runner/ (here $first_path) need a Role: trailer"

case "$role" in
  implementer | fixer) ;;
  *) exit 0 ;;
esac

specs="$(values Spec | tr ',' ' ')"
[ -n "$(printf '%s' "$specs" | tr -d ' \n\t')" ] ||
  reject "$role commits touching $first_path need a Spec: trailer with the spec ids they implement, e.g. 'Spec: search/grammar#G3'"
for id in $specs; do
  printf '%s' "$id" | grep -Eq '^((specs/)?[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9_-]*(\.md)?(#[A-Za-z0-9][A-Za-z0-9._-]*)?|R[0-9]+)$' ||
    reject "Spec: '$id' is not a spec id (<area>/<topic>#<section>, e.g. search/grammar#G3, or a requirement id such as R1987)"
done

sessions="$(values Session)"
if [ -z "$sessions" ]; then
  hint=""
  if [ -z "$commit" ] && [ -f "$git_dir/meguri-session.json" ] && command -v jq >/dev/null 2>&1; then
    hint=" ('Session: $(jq -r .session "$git_dir/meguri-session.json")' for this worktree)"
  fi
  reject "$role commits touching $first_path need a Session: trailer$hint"
fi
for s in $sessions; do
  printf '%s' "$s" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._:-]{2,}$' || reject "Session: '$s' is not a session id"
done
exit 0
