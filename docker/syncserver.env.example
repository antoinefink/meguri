# Test users of the local sync server (`tools/mg sync-rig up`), for simulator
# and Mac app end-to-end runs. Test accounts only: never put a real account
# here. To change them, copy this file to docker/syncserver.env (git-ignored);
# its values override these.
#
# The server reads SYNC_USER1..N once, at start, as <user>:<password>.
SYNC_USER1=meguri-a:meguri-test-a
SYNC_USER2=meguri-b:meguri-test-b
SYNC_USER3=meguri-c:meguri-test-c
SYNC_USER4=meguri-d:meguri-test-d
